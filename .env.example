DJANGO_SECRET_KEY=change-me-use-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://postgres:postgres@db:5432/hvac_ops
DATABASE_CONNECT_TIMEOUT=5
TIME_ZONE=America/Los_Angeles

# Docker Compose local database
POSTGRES_DB=hvac_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
WEB_PORT=8000

# Future integrations
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/app/credentials/google-service-account.json
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar
TELEGRAM_BOT_TOKEN=your_token_here
TECHNICIAN_BOT_TOKEN=your_technician_bot_token_here
TECHNICIAN_BOT_USERNAME=your_technician_bot_username
BACKEND_API_BASE_URL=http://web:8000
BACKEND_PUBLIC_BASE_URL=http://127.0.0.1:8000
PUBLIC_BASE_URL=http://localhost:8000
TECHNICIAN_API_SHARED_SECRET=change-me-for-telegram-submissions

# Production/Render
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
